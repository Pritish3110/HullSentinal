<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cleaner_robot">

  <xacro:arg name="robot_name" default="cleaner_1"/>
  <xacro:property name="name" value="$(arg robot_name)"/>

  <!-- High-contrast Industrial Materials -->
  <material name="cleaner_body_orange">
    <color rgba="1.0 0.42 0.0 1.0"/>
  </material>
  <material name="crawler_treads_dark">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="brush_green">
    <color rgba="0.0 0.9 0.3 1.0"/>
  </material>
  <material name="tool_arm_steel">
    <color rgba="0.45 0.48 0.52 1.0"/>
  </material>
  <material name="beacon_amber">
    <color rgba="1.0 0.7 0.0 1.0"/>
  </material>
  <material name="magnet_silver">
    <color rgba="0.75 0.75 0.8 1.0"/>
  </material>

  <!-- Base footprint on hull surface -->
  <link name="${name}/base_footprint"/>

  <joint name="${name}_base_joint" type="fixed">
    <parent link="${name}/base_footprint"/>
    <child link="${name}/base_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- Main Heavy Crawler Chassis (>0.7m length) -->
  <link name="${name}/base_link">
    <visual>
      <geometry>
        <box size="0.70 0.50 0.18"/>
      </geometry>
      <material name="cleaner_body_orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.70 0.50 0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="22.0"/>
      <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.7" iyz="0.0" izz="0.9"/>
    </inertial>
  </link>

  <!-- Left Heavy Magnetic Track Unit -->
  <link name="${name}/left_track">
    <visual>
      <geometry>
        <box size="0.76 0.12 0.14"/>
      </geometry>
      <material name="crawler_treads_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.76 0.12 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="${name}_left_track_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/left_track"/>
    <origin xyz="0 0.28 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- Right Heavy Magnetic Track Unit -->
  <link name="${name}/right_track">
    <visual>
      <geometry>
        <box size="0.76 0.12 0.14"/>
      </geometry>
      <material name="crawler_treads_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.76 0.12 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="${name}_right_track_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/right_track"/>
    <origin xyz="0 -0.28 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- Hydraulic Tool Arm Boom -->
  <link name="${name}/tool_arm">
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.14 0.08"/>
      </geometry>
      <material name="tool_arm_steel"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.14 0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="${name}_tool_arm_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/tool_arm"/>
    <origin xyz="0.35 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- Rotary Hydro-Scrubber / Cavitation Brush Head -->
  <link name="${name}/cleaning_tool">
    <visual>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
      <material name="brush_green"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/>
    </inertial>
  </link>
  <joint name="${name}_cleaning_tool_joint" type="fixed">
    <parent link="${name}/tool_arm"/>
    <child link="${name}/cleaning_tool"/>
    <origin xyz="0.24 0 -0.04" rpy="0 1.5707963 0"/>
  </joint>

  <!-- Top Avionics & Safety Beacon -->
  <link name="${name}/top_beacon">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <material name="beacon_amber"/>
    </visual>
  </link>
  <joint name="${name}_beacon_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/top_beacon"/>
    <origin xyz="-0.15 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- Magnetic Adhesion Pods (Underside visual cues) -->
  <link name="${name}/magnet_pod_front">
    <visual>
      <geometry>
        <box size="0.15 0.35 0.02"/>
      </geometry>
      <material name="magnet_silver"/>
    </visual>
  </link>
  <joint name="${name}_magnet_front_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/magnet_pod_front"/>
    <origin xyz="0.18 0 -0.10" rpy="0 0 0"/>
  </joint>

  <link name="${name}/magnet_pod_rear">
    <visual>
      <geometry>
        <box size="0.15 0.35 0.02"/>
      </geometry>
      <material name="magnet_silver"/>
    </visual>
  </link>
  <joint name="${name}_magnet_rear_joint" type="fixed">
    <parent link="${name}/base_link"/>
    <child link="${name}/magnet_pod_rear"/>
    <origin xyz="-0.18 0 -0.10" rpy="0 0 0"/>
  </joint>

</robot>
