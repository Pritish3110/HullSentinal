<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hull_benchmarks</name>
  <version>0.1.0</version>
  <description>Automated multi-scenario benchmarking, metric aggregation, and baseline comparison suite</description>
  <maintainer email="pritish@todo.todo">Pritish Bhatasana</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>hull_msgs</exec_depend>
  <exec_depend>hull_sim</exec_depend>
  <exec_depend>hull_control</exec_depend>
  <exec_depend>hull_swarm</exec_depend>
  <exec_depend>hull_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
